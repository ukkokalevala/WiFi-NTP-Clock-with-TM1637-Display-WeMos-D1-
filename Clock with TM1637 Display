#include <ESP8266WiFi.h>
#include <WiFiUdp.h>
#include <NTPClient.h>
#include <TM1637Display.h>

// ===== WiFi Credentials =====
const char* ssid     = "YOUR_SSID";
const char* password = "YOUR_PASSWORD";

// ===== TM1637 Pins =====
#define CLK 12   // D6 on WeMos D1
#define DIO 13   // D7 on WeMos D1

TM1637Display display(CLK, DIO);

// ===== NTP Setup =====
WiFiUDP ntpUDP;
// South Africa = UTC+2 = 7200 seconds offset
// 60000 = update NTP every 60 seconds
NTPClient timeClient(ntpUDP, "pool.ntp.org", 7200, 60000);

// ===== Toggle Variables (GLOBAL - important!) =====
unsigned long previousMillis = 0;
const long interval = 5000;      // switch every 5 seconds (5000ms)
bool showDate = false;

void setup() {
  Serial.begin(115200);
  delay(100);

  // Initialize display
  display.setBrightness(0x0f);
  display.clear();

  // Show a startup indicator (all 8s)
  display.showNumberDec(8888);

  // Connect to WiFi
  Serial.println();
  Serial.print("Connecting to WiFi");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println();
  Serial.println("WiFi connected!");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  // Start NTP client
  timeClient.begin();
  timeClient.update();
  Serial.println("NTP time synced.");
}

void loop() {
  // Keep NTP client updated (it self-throttles to every 60s)
  timeClient.update();

  // ===== Toggle Logic (only flips every 'interval' ms) =====
  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;
    showDate = !showDate;

    Serial.print("Mode: ");
    Serial.println(showDate ? "DATE" : "TIME");
  }

  // ===== Display =====
  if (showDate) {
    // --- Show Date as MMDD ---
    time_t rawTime = timeClient.getEpochTime();
    struct tm *ti = localtime(&rawTime);

    int month = ti->tm_mon + 1;   // tm_mon is 0-11, so +1
    int day   = ti->tm_mday;

    // Middle colon OFF when showing date (so it's clearly "date mode")
    display.showNumberDecEx(month * 100 + day, 0b00000000, true, 4);
  } else {
    // --- Show Time as HHMM ---
    int hours   = timeClient.getHours();
    int minutes = timeClient.getMinutes();

    // Middle colon ON when showing time
    display.showNumberDecEx(hours * 100 + minutes, 0b01000000, true, 4);
  }

  delay(100);
}
